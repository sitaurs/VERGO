  "schemas": {
    "PublicIncidentListItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "in_progress",
            "resolved"
          ]
        },
        "categoryId": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/CategoryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "area": {
          "type": "object",
          "properties": {
            "cellId": {
              "type": "string",
              "pattern": "^[0-9a-f]{15}$"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "cellId",
            "label"
          ],
          "additionalProperties": false
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastObservedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PublicEvidence"
          }
        },
        "supportCount": {
          "type": "integer",
          "minimum": 0
        },
        "canonicalPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "status",
        "categoryId",
        "area",
        "occurredAt",
        "lastObservedAt",
        "updatedAt",
        "evidence",
        "supportCount",
        "canonicalPath"
      ],
      "additionalProperties": false
    },
